# 环境变量示例：复制为 .env 后按需修改。
# 注意：.env 已在 .gitignore 中，不会被提交。

# ---- 运行参数（覆盖 configs/default.yaml 的 run 节）----
# ADOPS_ACCOUNT=我的投放账户
# ADOPS_SOURCE=csv
# ADOPS_DATA_FILE=path/to/export.csv
# ADOPS_LAYOUT=aggregated
# ADOPS_OUT_DIR=outputs

# ---- LLM（可选）----
# 未配置密钥时流水线自动使用确定性模板，报告照常产出。
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# ADOPS_LLM=true
